					"그 <<npcVagina_ nun>> 굶주렸어. 네 씨앗으로 채워 주라고."
				<</addinlineevent>>
			<</if>>
			<<if $penisstate is "otheranus">>
				<<addinlineevent "" 1>>
				"<<pShes_ nun>> 저 <<print either("엉덩이", "엉덩이", "뒷구멍")>>에 둥지를 틀 생각인가 봐."
				<</addinlineevent>>
			<</if>>
			<<if $penisstate is "othermouth">>
				<<addinlineevent "" 1>>
				<<personselect $penistarget>>
				"<<Hes_ ga>> 네 아래쪽 부리를 빨아주고 있네. 사랑스러워라."
				<</addinlineevent>>
			<</if>>
			<<if $anusstate is "penetrated">>
				<<addinlineevent "" 1>>
				<<personselect $anustarget>>
				"<<pshe_ ga>> 세이렌의 노래로 <<him_ rul>> 유혹했으니, 마땅한 벌이지."
				<</addinlineevent>>
			<</if>>
			<<if $anusstate is "doublepenetrated">>
				<<addinlineevent "" 1>>
				"너는 철새구나? 전 세계의 좆들이 네 <<print either("엉덩이", "엉덩이", "뒷구멍")>>에 있잖아."
				<</addinlineevent>>
			<</if>>
			<<if $mouthstate is "penetrated">>
				<<if npcHasStrapon()>>
					<<addinlineevent "" 1>>
					"이 새가 플라스틱을 빨고 있네. 먹이통에 너무 익숙해진 모양이야."
					<</addinlineevent>>
				<<else>>
					<<addinlineevent "" 1>>
					<<personselect $mouthtarget>>
					"새야, 물통을 빨면서 카메라를 보렴."
					<</addinlineevent>>
				<</if>>
			<</if>>
			<<if $mouthstate is "othervagina">>
				<<addinlineevent "" 1>>
				<<personselect $mouthtarget>>
				"저 잉꼬가 <<npcVaginaPost>>에 키스하는 것 좀 봐!"
				<</addinlineevent>>
			<</if>>
			<<if $mouthstate is "otheranus">>
				<<addinlineevent "" 1>>
				<<personselect $mouthtarget>>
				"이 가여운 새는 방향 감각을 완전히 잃었나 봐. 저 <<print either("엉덩이", "엉덩이", "뒷구멍")>>에 혀를 깊숙이 담근 채로 길을 잃었어."
				<</addinlineevent>>
			<</if>>
		<</if>>
		<<addinlineevent "" 1>>
			<<if $orgasmdown gte 1>>
				<<if $face is "covered">>
					"완전히 걸레잖아."
				<<else>>
					"<<pherPost "의">> 떨림이 사진에 담겼으면 좋겠어."
				<</if>>
			<<else>>
				<<if $face is "covered">>
					<<if $pain gte 80>>
						"<<pshesPost "이">> 아픈 것 같아. 멈추지 마."
					<<elseif $pain gte 40>>
						"눈물을 가리려 애쓰지 마, 우린 다 볼 수 있어."
					<<else>>
						"손을 움직여 <<bitchPost "아">>, 네 얼굴 사진을 찍고 싶다고."
					<</if>>
				<<elseif $speechcamerapose is 1>>
					<<if $pain gte 80>>
						"고통에도 포즈를 취하다니. 용감한데."
					<<elseif $pain gte 40>>
						"용감한 얼굴을 하라고, 알았지?"
					<<else>>
						"이 <<slut_ un>> 카메라가 어떻게 생긴 건지 알고 있구만."
					<</if>>
				<<else>>
					<<if $pain gte 80>>
						"이제 모든 사람이 네가 얼마나 불쌍한지 알게 되겠지."
					<<elseif $pain gte 40>>
						"잘 찍혔네, 이건 눈물인가?"
					<<else>>
						"친구들과 나눠 볼 생각에 기대되는걸."
					<</if>>
				<</if>>
			<</if>>
		<</addinlineevent>>
		<<runeventpool>>
		<br>
	<</if>>

	<<if $face isnot "covered">>
		<<if $exposed is 1>>
			<<fameexhibitionism 1 "pic">>
		<<elseif $exposed gte 2>>
			<<fameexhibitionism 2 "pic">>
		<</if>>
		<<if playerBellyVisible()>>
			<<famepregnancy 1 "pic">>
		<</if>>
		<<if $sexavoid is 0 or $rapeavoid is 0>>
			<<if $consensual is 1>>
				<<famesex 1 "pic">>
			<<else>>
				<<famerape 1 "pic">>
			<</if>>
			<<if $enemytype is "beast">>
				<<famebestiality 1 "pic">>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "ahe">><<silently>>
	<<if ["man", "boy"].includes($audiencecamera)>>
		<<set _text_output to "그">>
	<<elseif ["woman", "girl"].includes($audiencecamera)>>
		<<set _text_output to "그녀">>
	<<elseif $audiencecamera>>
		<<set _text_output to `<span class="red">[ERROR: unrecognised audiencecamera value $audiencecamera in "ahe"]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[ERROR: undefined audiencecamera in "ahe"]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "aHe">>
	<<ahe>><<capitalise>>
<</widget>>

<<widget "ahis">><<silently>>
	<<if ["man", "boy"].includes($audiencecamera)>>
