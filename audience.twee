	<<elseif ["woman", "girl"].includes($audiencecamera)>>
		<<set _text_output to "그녀의">>
	<<elseif $audiencecamera>>
		<<set _text_output to `<span class="red">[ERROR: unrecognised audiencecamera value $audiencecamera in "ahis"]</span>`>>
	<<else>>
		<<set _text_output to `<span class="red">[ERROR: undefined audiencecamera in "ahis"]</span>`>>
	<</if>>
<</silently>>_text_output<</widget>>

<<widget "aHis">>
	<<ahis>><<capitalise>>
